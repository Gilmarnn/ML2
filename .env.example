# Credenciais do app criado em https://developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser EXATAMENTE igual a URL de callback cadastrada no app do Mercado Livre
ML_REDIRECT_URI=http://localhost:3000/auth/callback

# String aleatoria longa, so pra assinar a sessao (pode gerar com: openssl rand -hex 32)
SESSION_SECRET=troque_isso_por_uma_string_aleatoria_grande

# Protege o acesso administrativo (voce, o dono da ferramenta) via /admin-login.html.
# Escolha um usuario e senha fortes.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Conexao com o banco Postgres. No Railway, adicione o plugin "Postgres" ao
# projeto e essa variavel e preenchida automaticamente — nao precisa mexer.
# Para rodar local, aponte para um Postgres seu (ex: postgres://user:senha@localhost:5432/diagnostico)
DATABASE_URL=

# Access Token da sua conta do Mercado Pago (producao ou teste), pego em
# https://www.mercadopago.com.br/developers/panel — usado para criar as
# assinaturas recorrentes e consultar status no webhook.
MP_ACCESS_TOKEN=

# Valor mensal da assinatura em reais (numero, sem "R$")
SUBSCRIPTION_PRICE_BRL=49.90

# Modo de teste da assinatura: coloque "true" para simular um pagamento
# aprovado na hora, sem precisar configurar conta nenhuma no Mercado Pago
# ainda. Libera o acesso automaticamente ao clicar em "Assinar agora".
# Deixe em branco ou "false" quando for testar com o Mercado Pago de verdade.
MP_MOCK_MODE=true

# Opcional: se quiser habilitar as sugestoes de diagnostico geradas por IA (via API da Anthropic)
# Sem essa chave, o diagnostico funciona normalmente, so no modo regras/score (sem texto gerado por IA)
ANTHROPIC_API_KEY=

# Modo de teste da analise por IA: coloque "true" para ver uma resposta de EXEMPLO
# no botao de analise profunda, sem gastar credito nenhum na API da Anthropic
AI_MOCK_MODE=true

PORT=3000
