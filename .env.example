# Visium Seller 2.0
NODE_ENV=production
APP_URL=https://seu-dominio.up.railway.app
PORT=3000

# Banco / sessão
DATABASE_URL=
SESSION_SECRET=
DB_POOL_MAX=10

# Admin da plataforma
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://seu-dominio.up.railway.app/auth/callback

# TikTok Shop Partner Center (opcional; o botão só é ativado quando tudo abaixo estiver preenchido)
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_REDIRECT_URI=https://seu-dominio.up.railway.app/integrations/callback/tiktok
# ROW padrão. Para um mercado que use outro domínio, sobrescreva.
TIKTOK_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com

# Shopee Open Platform (opcional)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://seu-dominio.up.railway.app/integrations/callback/shopee
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com

# Mercado Pago - assinatura mensal recorrente
MP_ACCESS_TOKEN=
SUBSCRIPTION_PRICE_BRL=49.90
SUBSCRIPTION_REASON=Visium Seller - assinatura mensal
MP_MOCK_MODE=false

# Recuperação de senha
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_MOCK_MODE=false

# Análise profunda por IA (opcional)
ANTHROPIC_API_KEY=
AI_MOCK_MODE=false
